import numpy as np
import cupy as cp
from numba import cuda, uint64
import math

_EMPTY = -1

@cuda.jit(device=True)
def _expand_bits(v):
    v = (v * 0x00010001) & 0xFF0000FF
    v = (v * 0x00000101) & 0x0F00F00F
    v = (v * 0x00000011) & 0xC30C30C3
    v = (v * 0x00000005) & 0x49249249
    return v

@cuda.jit
def _morton_code_kernel(positions, morton_codes, particle_indices, min_coord, inv_box_size):
    i = cuda.grid(1)
    if i >= positions.shape[0]: return
    norm_x = int(((positions[i, 0] - min_coord[0]) * inv_box_size) * 2147483647.0)
    norm_y = int(((positions[i, 1] - min_coord[1]) * inv_box_size) * 2147483647.0)
    norm_z = int(((positions[i, 2] - min_coord[2]) * inv_box_size) * 2147483647.0)
    morton_codes[i] = (_expand_bits(norm_x) | _expand_bits(norm_y) << 1 | _expand_bits(norm_z) << 2)
    particle_indices[i] = i

def calculate_forces(positions, masses, G, epsilon, theta=0.5, dtype=np.float64, debug_particle_idx=-1, debug_tree_structure=False, **kwargs):
    num_particles = positions.shape[0]
    if num_particles <= 1:
        return {"forces": cp.zeros_like(positions), "timings": {}, "metrics": {"interaction_count": 0}}

    threads_per_block = 256
    start_event, end_event = cp.cuda.Event(), cp.cuda.Event()
    
    d_positions, d_masses = positions, masses

    start_event.record()
    blocks_per_grid_particles = (num_particles + (threads_per_block - 1)) // threads_per_block
    min_coord, max_coord = d_positions.min(axis=0), d_positions.max(axis=0)
    box_size = (max_coord - min_coord).max().item()
    if box_size == 0: box_size = 1.0
    inv_box_size = 1.0 / box_size
    d_morton_codes = cp.empty(num_particles, dtype=cp.uint64)
    d_particle_indices = cp.empty(num_particles, dtype=cp.int32)
    _morton_code_kernel[blocks_per_grid_particles, threads_per_block](
        d_positions, d_morton_codes, d_particle_indices, min_coord, inv_box_size
    )
    sort_order = cp.argsort(d_morton_codes)
    d_sorted_morton_codes = d_morton_codes[sort_order]
    d_sorted_particle_indices = d_particle_indices[sort_order]
    end_event.record()
    end_event.synchronize()
    t_sort = cp.cuda.get_elapsed_time(start_event, end_event)

    start_event.record()
    num_internal_nodes = num_particles - 1
    max_nodes = num_particles + num_internal_nodes
    d_node_parent = cp.full(max_nodes, _EMPTY, dtype=cp.int32)
    d_node_children = cp.full((max_nodes, 8), _EMPTY, dtype=cp.int32)
    d_internal_left = cp.full(num_internal_nodes, -1, dtype=cp.int32)
    d_internal_right = cp.full(num_internal_nodes, -1, dtype=cp.int32)

    # Build the tree topology (parent relationships)
    tree_build_blocks = (num_particles + threads_per_block - 1) // threads_per_block

    # Allocate optional debug buffers when requested
    if debug_tree_structure:
        d_debug_dir = cp.zeros(num_particles - 1, dtype=cp.int32)
        d_debug_j = cp.full(num_particles - 1, -999999, dtype=cp.int32)
        d_debug_left = cp.full(num_particles - 1, -999999, dtype=cp.int32)
        d_debug_right = cp.full(num_particles - 1, -999999, dtype=cp.int32)
        d_debug_split = cp.full(num_particles - 1, -999999, dtype=cp.int32)
        d_debug_lcp_prev = cp.full(num_particles - 1, -999999, dtype=cp.int32)
        d_debug_lcp_next = cp.full(num_particles - 1, -999999, dtype=cp.int32)
        d_debug_delta_min = cp.full(num_particles - 1, -999999, dtype=cp.int32)
        d_debug_internal_left = cp.full(num_particles - 1, -999999, dtype=cp.int32)

        _build_tree_topology_kernel_debug[tree_build_blocks, threads_per_block](
            d_sorted_morton_codes, d_node_parent, num_particles, d_internal_left, d_internal_right,
            d_debug_dir, d_debug_j, d_debug_left, d_debug_right, d_debug_split,
            d_debug_lcp_prev, d_debug_lcp_next, d_debug_delta_min,
            d_debug_internal_left
        )
    else:
        _build_tree_topology_kernel[tree_build_blocks, threads_per_block](
            d_sorted_morton_codes, d_node_parent, num_particles, d_internal_left, d_internal_right
        )
    
    # Connect children to their parents
    connect_children_blocks = (max_nodes + threads_per_block - 1) // threads_per_block
    _connect_children_kernel[connect_children_blocks, threads_per_block](
        d_sorted_morton_codes, d_node_parent, d_internal_left, d_internal_right, d_node_children, num_particles
    )
    end_event.record()
    end_event.synchronize()
    t_tree = cp.cuda.get_elapsed_time(start_event, end_event)

    start_event.record()
    d_node_com = cp.zeros((max_nodes, 3), dtype=dtype)
    d_node_mass = cp.zeros(max_nodes, dtype=dtype)
    d_node_bounds = cp.zeros((max_nodes, 6), dtype=dtype)
    
    _initialize_leaves_kernel[blocks_per_grid_particles, threads_per_block](
        d_node_com, d_node_mass, d_node_bounds, d_sorted_particle_indices,
        d_positions, d_masses, num_particles
    )
    
    blocks_per_grid_internal = (num_internal_nodes + threads_per_block - 1) // threads_per_block
    for _ in range(int(math.log2(num_particles)) + 2):
        _com_sweep_kernel[blocks_per_grid_internal, threads_per_block](
            d_node_children, d_node_com, d_node_mass, num_particles
        )
        _calculate_internal_bounds_kernel[blocks_per_grid_internal, threads_per_block](
            d_node_children, d_node_bounds, num_particles
        )
        
    end_event.record()
    end_event.synchronize()
    t_com = cp.cuda.get_elapsed_time(start_event, end_event)

    start_event.record()
    d_forces = cp.zeros_like(d_positions)
    d_interaction_counts = cp.zeros(num_particles, dtype=cp.int64)
    
    debug_out = None
    if debug_particle_idx != -1:
        debug_out = cp.zeros(num_particles, dtype=cp.int32)
    else:
        # Provide a dummy array to satisfy the compiler's type inference
        debug_out = cp.zeros(1, dtype=cp.int32)
        
    root_nodes = cp.where(d_node_parent == _EMPTY)[0]
    root_node_idx = root_nodes[0].item() if len(root_nodes) > 0 else 0

    _force_calculation_kernel[blocks_per_grid_particles, threads_per_block](
        d_positions, d_masses, d_forces, G, epsilon, theta,
        root_node_idx, d_node_children, d_node_com, d_node_mass, d_node_bounds, 
        num_particles, d_sorted_particle_indices, d_interaction_counts,
        debug_particle_idx, debug_out
    )
    end_event.record()
    end_event.synchronize()
    t_force = cp.cuda.get_elapsed_time(start_event, end_event)
    
    interaction_count = int(cp.sum(d_interaction_counts))

    timings = {"sort": t_sort, "tree_build": t_tree, "com_calc": t_com, "force_calculation": t_force}
    
    result = {"forces": d_forces, "timings": timings, "metrics": {"interaction_count": interaction_count}}
    
    if debug_out is not None:
        result["debug_out"] = debug_out
        
    if debug_tree_structure:
        result["node_parent"] = d_node_parent
        result["node_children"] = d_node_children
        result["topo_debug"] = {
            "dir": d_debug_dir,
            "j": d_debug_j,
            "left": d_debug_left,
            "right": d_debug_right,
            "split": d_debug_split,
            "lcp_prev": d_debug_lcp_prev,
            "lcp_next": d_debug_lcp_next,
            "delta_min": d_debug_delta_min,
            "internal_left": d_debug_internal_left,
        }
        
    return result

@cuda.jit(device=True)
def _common_prefix_length(a, b):
    if a == b: return 64
    xor_val = a ^ b
    if xor_val == 0: return 64
    if xor_val >> 32: return cuda.clz(uint64(xor_val >> 32))
    else: return cuda.clz(uint64(xor_val & 0xFFFFFFFF)) + 32

@cuda.jit(device=True)
def _get_octant_gpu(code1, code2):
    prefix_len = _common_prefix_length(code1, code2)
    if prefix_len >= 61: return 0
    shift = 60 - prefix_len
    return (code2 >> int(shift)) & 7


@cuda.jit(device=True)
def _delta(codes, n, i, j):
    # Returns the LCP between codes[i] and codes[j], or -1 if j is out of range
    if j < 0 or j >= n:
        return -1
    return _common_prefix_length(codes[i], codes[j])


@cuda.jit
def _build_tree_topology_kernel(codes, parents, n, internal_left, internal_right):
    i = cuda.grid(1)
    # We construct the binary radix tree topology following Karras (2012)
    # Launch with n-1 threads (one per internal node). Threads >= n-1 exit.
    if i >= n - 1:
        return

    leaf_base = n - 1

    # Determine direction of the range (+1 or -1) using neighbor LCPs with boundary guards
    lcp_next = _delta(codes, n, i, i + 1)
    lcp_prev = _delta(codes, n, i, i - 1)
    d = 1 if lcp_next > lcp_prev else -1

    # Compute minimum LCP with the neighbor in the chosen direction
    delta_min = _delta(codes, n, i, i - d)

    # Find the maximum length of the range by exponential search
    l_max = 1
    while _delta(codes, n, i, i + l_max * d) > delta_min:
        l_max <<= 1

    # Find the other end j of the range by binary search
    l = 0
    t = l_max
    while t > 1:
        t = (t + 1) >> 1
        if _delta(codes, n, i, i + (l + t) * d) > delta_min:
            l += t
    j = i + l * d

    # Ensure left <= right
    left = i if i < j else j
    right = j if i < j else i

    # Find the split position using binary search with respect to common prefix with codes[i]
    common_prefix = _common_prefix_length(codes[i], codes[j])
    split = left
    step = right - left
    while step > 1:
        step = (step + 1) >> 1
        new_split = split + step
        if new_split < right:
            split_prefix = _common_prefix_length(codes[i], codes[new_split])
            if split_prefix > common_prefix:
                split = new_split

    # Determine children (either leaf or internal)
    left_child_leaf = (split == left)
    right_child_leaf = ((split + 1) == right)

    left_child_idx = (leaf_base + split) if left_child_leaf else split
    right_child_idx = (leaf_base + split + 1) if right_child_leaf else (split + 1)

    # Set parents for both children; this thread is the unique writer for internal node i
    parents[left_child_idx] = i
    parents[right_child_idx] = i
    internal_left[i] = left
    internal_right[i] = right


@cuda.jit
def _build_tree_topology_kernel_debug(codes, parents, n, internal_left, internal_right,
                                      debug_dir, debug_j, debug_left, debug_right, debug_split,
                                      debug_lcp_prev, debug_lcp_next, debug_delta_min,
                                      debug_internal_left):
    i = cuda.grid(1)
    if i >= n - 1:
        return

    leaf_base = n - 1

    lcp_next = _delta(codes, n, i, i + 1)
    lcp_prev = _delta(codes, n, i, i - 1)
    d = 1 if lcp_next > lcp_prev else -1

    delta_min = _delta(codes, n, i, i - d)

    l_max = 1
    while _delta(codes, n, i, i + l_max * d) > delta_min:
        l_max <<= 1

    l = 0
    t = l_max
    while t > 1:
        t = (t + 1) >> 1
        if _delta(codes, n, i, i + (l + t) * d) > delta_min:
            l += t
    j = i + l * d

    left = i if i < j else j
    right = j if i < j else i

    common_prefix = _common_prefix_length(codes[i], codes[j])
    split = left
    step = right - left
    while step > 1:
        step = (step + 1) >> 1
        new_split = split + step
        if new_split < right:
            split_prefix = _common_prefix_length(codes[i], codes[new_split])
            if split_prefix > common_prefix:
                split = new_split

    left_child_leaf = (split == left)
    right_child_leaf = ((split + 1) == right)

    left_child_idx = (leaf_base + split) if left_child_leaf else split
    right_child_idx = (leaf_base + split + 1) if right_child_leaf else (split + 1)

    parents[left_child_idx] = i
    parents[right_child_idx] = i
    internal_left[i] = left
    internal_right[i] = right

    # write debug
    debug_dir[i] = d
    debug_j[i] = j
    debug_left[i] = left
    debug_right[i] = right
    debug_split[i] = split
    debug_lcp_prev[i] = lcp_prev
    debug_lcp_next[i] = lcp_next
    debug_delta_min[i] = delta_min
    debug_internal_left[i] = left
    
@cuda.jit
def _connect_children_kernel(codes, parents, internal_left, internal_right, children, n):
    i = cuda.grid(1)
    if i >= n * 2 - 1: return

    parent = parents[i]
    if parent != _EMPTY:
        # Compute parent prefix using its [left,right] endpoints
        Lp = internal_left[parent]
        Rp = internal_right[parent]
        parent_prefix = _common_prefix_length(codes[Lp], codes[Rp])
        if parent_prefix >= 61:
            parent_prefix = 61
        shift = 60 - parent_prefix

        # Child code: internal -> left endpoint; leaf -> own code
        if i < (n - 1):
            child_code = codes[internal_left[i]]
        else:
            child_code = codes[i - (n - 1)]
        octant = (child_code >> int(shift)) & 7
        children[parent, octant] = i



@cuda.jit
def _initialize_leaves_kernel(node_com, node_mass, node_bounds, sorted_particle_indices, positions, masses, num_particles):
    i = cuda.grid(1)
    if i >= num_particles: return
    leaf_idx = num_particles - 1 + i
    particle_idx = sorted_particle_indices[i]
    
    px, py, pz = positions[particle_idx, 0], positions[particle_idx, 1], positions[particle_idx, 2]
    
    node_com[leaf_idx, 0], node_com[leaf_idx, 1], node_com[leaf_idx, 2] = px, py, pz
    node_mass[leaf_idx] = masses[particle_idx]
    
    node_bounds[leaf_idx, 0], node_bounds[leaf_idx, 1] = px, px
    node_bounds[leaf_idx, 2], node_bounds[leaf_idx, 3] = py, py
    node_bounds[leaf_idx, 4], node_bounds[leaf_idx, 5] = pz, pz

@cuda.jit
def _com_sweep_kernel(node_children, node_com, node_mass, num_particles):
    i = cuda.grid(1)
    if i >= num_particles - 1: return
    total_mass, wx, wy, wz = 0.0, 0.0, 0.0, 0.0
    for child_idx_in_octant in range(8):
        child = node_children[i, child_idx_in_octant]
        if child != _EMPTY:
            mass = node_mass[child]
            if mass > 0:
                total_mass += mass
                wx += node_com[child, 0] * mass
                wy += node_com[child, 1] * mass
                wz += node_com[child, 2] * mass
    if total_mass > 0:
        inv_mass = 1.0 / total_mass
        node_com[i, 0], node_com[i, 1], node_com[i, 2] = wx * inv_mass, wy * inv_mass, wz * inv_mass
        node_mass[i] = total_mass

@cuda.jit
def _calculate_internal_bounds_kernel(node_children, node_bounds, num_particles):
    i = cuda.grid(1)
    if i >= num_particles - 1: return

    min_x, max_x = 1e10, -1e10
    min_y, max_y = 1e10, -1e10
    min_z, max_z = 1e10, -1e10

    for child_idx_in_octant in range(8):
        child = node_children[i, child_idx_in_octant]
        if child != _EMPTY:
            c_min_x, c_max_x = node_bounds[child, 0], node_bounds[child, 1]
            if c_min_x <= c_max_x:
                min_x = min(min_x, c_min_x)
                max_x = max(max_x, c_max_x)
            c_min_y, c_max_y = node_bounds[child, 2], node_bounds[child, 3]
            if c_min_y <= c_max_y:
                min_y = min(min_y, c_min_y)
                max_y = max(max_y, c_max_y)
            c_min_z, c_max_z = node_bounds[child, 4], node_bounds[child, 5]
            if c_min_z <= c_max_z:
                min_z = min(min_z, c_min_z)
                max_z = max(max_z, c_max_z)
    
    if min_x <= max_x:
        node_bounds[i, 0], node_bounds[i, 1] = min_x, max_x
        node_bounds[i, 2], node_bounds[i, 3] = min_y, max_y
        node_bounds[i, 4], node_bounds[i, 5] = min_z, max_z

@cuda.jit(device=True)
def _calculate_force_on_particle_gpu(particle_idx, root_node_idx, positions, masses, G, epsilon, theta,
                                   node_children, node_com, node_mass, node_bounds, sorted_particle_indices, num_particles,
                                   sorted_debug_idx, debug_out):
    force_x, force_y, force_z, interactions = 0.0, 0.0, 0.0, 0
    orig_particle_idx = sorted_particle_indices[particle_idx]
    px, py, pz = positions[orig_particle_idx, 0], positions[orig_particle_idx, 1], positions[orig_particle_idx, 2]
    
    stack = cuda.local.array(shape=64, dtype=np.int32)
    stack_ptr = 0
    stack[stack_ptr] = root_node_idx
    stack_ptr += 1

    while stack_ptr > 0:
        stack_ptr -= 1
        node_idx = stack[stack_ptr]
        
        if node_mass[node_idx] == 0:
            continue

        # Check if the node is a leaf
        is_leaf = True
        for i in range(8):
            if node_children[node_idx, i] != _EMPTY:
                is_leaf = False
                break
        
        # If it's a leaf node, calculate direct interaction if it's not the particle itself
        if is_leaf:
            if node_mass[node_idx] > 0 and node_idx != (num_particles - 1 + particle_idx):
                
                # Debugging: Record this interaction
                if particle_idx == sorted_debug_idx:
                    leaf_orig_idx = sorted_particle_indices[node_idx - (num_particles - 1)]
                    debug_out[leaf_orig_idx] = 1

                rij_x = node_com[node_idx, 0] - px
                rij_y = node_com[node_idx, 1] - py
                rij_z = node_com[node_idx, 2] - pz
                d_sq = rij_x*rij_x + rij_y*rij_y + rij_z*rij_z + epsilon*epsilon
                inv_dist_cubed = d_sq**(-1.5)
                force_mag = G * masses[orig_particle_idx] * node_mass[node_idx] * inv_dist_cubed
                force_x += force_mag * rij_x
                force_y += force_mag * rij_y
                force_z += force_mag * rij_z
                interactions += 1
            continue

        # For internal nodes, apply the Barnes-Hut approximation
        s_x = node_bounds[node_idx, 1] - node_bounds[node_idx, 0]
        s_y = node_bounds[node_idx, 3] - node_bounds[node_idx, 2]
        s_z = node_bounds[node_idx, 5] - node_bounds[node_idx, 4]
        s = max(s_x, max(s_y, s_z))
        
        rij_x, rij_y, rij_z = node_com[node_idx, 0] - px, node_com[node_idx, 1] - py, node_com[node_idx, 2] - pz
        d_sq = rij_x*rij_x + rij_y*rij_y + rij_z*rij_z

        if s > 0 and (s*s / d_sq) < (theta * theta):
            # Node is far enough, approximate it as a single particle
            d_sq += epsilon*epsilon
            inv_dist_cubed = d_sq**(-1.5)
            force_mag = G * masses[orig_particle_idx] * node_mass[node_idx] * inv_dist_cubed
            force_x += force_mag * rij_x
            force_y += force_mag * rij_y
            force_z += force_mag * rij_z
            interactions += 1
        else:
            # Node is too close, traverse its children
            for i in range(8):
                child_idx = node_children[node_idx, i]
                if child_idx != _EMPTY and stack_ptr < 64:
                    stack[stack_ptr] = child_idx
                    stack_ptr += 1
    
    return force_x, force_y, force_z, interactions

@cuda.jit
def _force_calculation_kernel(positions, masses, forces, G, epsilon, theta,
                            root_node_idx, node_children, node_com, node_mass, node_bounds, num_particles,
                            sorted_particle_indices, interaction_counts,
                            debug_particle_idx, debug_out):
    i = cuda.grid(1)
    if i >= num_particles: return
    
    # Find the sorted index for the particle we are debugging
    # This is a simple linear scan, which is inefficient but acceptable for a debug-only feature.
    # In a performance-critical scenario, this would be handled differently.
    sorted_debug_idx = -1
    if debug_particle_idx != -1:
        for j in range(num_particles):
            if sorted_particle_indices[j] == debug_particle_idx:
                sorted_debug_idx = j
                break

    fx, fy, fz, interactions = _calculate_force_on_particle_gpu(
        i, root_node_idx, positions, masses, G, epsilon, theta,
        node_children, node_com, node_mass, node_bounds, sorted_particle_indices, num_particles,
        sorted_debug_idx, debug_out
    )
    orig_particle_idx = sorted_particle_indices[i]
    forces[orig_particle_idx, 0] = fx
    forces[orig_particle_idx, 1] = fy
    forces[orig_particle_idx, 2] = fz
    interaction_counts[i] = interactions
